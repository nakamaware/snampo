rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Notion の手順では画像アップロードが rooms 作成より先なので、
    // ここでは Auth 済みであることだけを見る。
    match /rooms/{roomCode}/mission/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /rooms/{roomCode}/thumbs/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
